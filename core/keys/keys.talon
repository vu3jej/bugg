<user.letter_key>:
    key(letter_key)
(ship|uppercase)<user.letter_keys>[(lowercase|sunk)]:
    user.insert_formatted_text(letter_keys, 'allCaps')
<user.number_key>:
    key(number_key)
<user.modifier_key>:
    key(modifier_key)
<user.navigation_key>:
    key(navigation_key)
<user.function_key>:
    key(function_key)
<user.whitespace_key>:
    key(whitespace_key)
<user.symbol_key>:
    key(symbol_key)
<user.shortcut>:
    key(shortcut)
